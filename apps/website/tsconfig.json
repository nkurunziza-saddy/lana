{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "moduleDetection": "force",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "declaration": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@lana/ui": ["../../packages/ui/src/index.ts"],
      "@lana/ui/*": ["../../packages/ui/src/*"],
      "@lana/editor": ["../../packages/editor/src/index.tsx"],
      "@lana/editor/*": ["../../packages/editor/src/*"],
      "@lana/utils": ["../../packages/utils/src/index.ts"],
      "@lana/utils/*": ["../../packages/utils/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
